# ===========================================
# 业务服务层 Docker Compose 模板
# 复制此文件为 docker-compose.services.yml 并填入真实值
# docker-compose.services.yml 不会被提交到GitHub
#
# 使用方式:
# cp docker-compose.services.yml.example docker-compose.services.yml
# 然后编辑 docker-compose.services.yml 填入真实的服务器IP和密码
# ===========================================

services:
  # ============ Application Services ============
  user-service:
    image: takeout/user-service:latest
    container_name: takeout-user
    ports:
      - "8081:8081"
    environment:
      - NACOS_SERVER_ADDR=${NACOS_SERVER_ADDR}
      - NACOS_USERNAME=${NACOS_USERNAME:-nacos}
      - NACOS_PASSWORD=${NACOS_PASSWORD:-nacos}
      - NACOS_DISCOVERY_IP=${NACOS_DISCOVERY_IP}
      - MYSQL_HOST=${MYSQL_HOST}
      - MYSQL_PORT=3306
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
      - REDIS_HOST=${REDIS_HOST}
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
    depends_on:
      - nacos-check
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped

  merchant-service:
    image: takeout/merchant-service:latest
    container_name: takeout-merchant
    ports:
      - "8083:8083"
    environment:
      - NACOS_SERVER_ADDR=${NACOS_SERVER_ADDR}
      - NACOS_USERNAME=${NACOS_USERNAME:-nacos}
      - NACOS_PASSWORD=${NACOS_PASSWORD:-nacos}
      - NACOS_DISCOVERY_IP=${NACOS_DISCOVERY_IP}
      - MYSQL_HOST=${MYSQL_HOST}
      - MYSQL_PORT=3306
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
    depends_on:
      - nacos-check
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped

  order-service:
    image: takeout/order-service:latest
    container_name: takeout-order
    ports:
      - "8084:8084"
    environment:
      - NACOS_SERVER_ADDR=${NACOS_SERVER_ADDR}
      - NACOS_USERNAME=${NACOS_USERNAME:-nacos}
      - NACOS_PASSWORD=${NACOS_PASSWORD:-nacos}
      - NACOS_DISCOVERY_IP=${NACOS_DISCOVERY_IP}
      - MYSQL_HOST=${MYSQL_HOST}
      - MYSQL_PORT=3306
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
      - RABBITMQ_HOST=${RABBITMQ_HOST}
      - RABBITMQ_PORT=5672
      - RABBITMQ_USERNAME=${RABBITMQ_USERNAME:-takeout}
      - RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD}
    depends_on:
      - nacos-check
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped

  payment-service:
    image: takeout/payment-service:latest
    container_name: takeout-payment
    ports:
      - "8085:8085"
    environment:
      - NACOS_SERVER_ADDR=${NACOS_SERVER_ADDR}
      - NACOS_USERNAME=${NACOS_USERNAME:-nacos}
      - NACOS_PASSWORD=${NACOS_PASSWORD:-nacos}
      - NACOS_DISCOVERY_IP=${NACOS_DISCOVERY_IP}
      - MYSQL_HOST=${MYSQL_HOST}
      - MYSQL_PORT=3306
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
      - RABBITMQ_HOST=${RABBITMQ_HOST}
      - RABBITMQ_PORT=5672
      - RABBITMQ_USERNAME=${RABBITMQ_USERNAME:-takeout}
      - RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD}
      - REDIS_HOST=${REDIS_HOST}
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
    depends_on:
      - nacos-check
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped

  notification-service:
    image: takeout/notification-service:latest
    container_name: takeout-notification
    ports:
      - "8086:8086"
    environment:
      - NACOS_SERVER_ADDR=${NACOS_SERVER_ADDR}
      - NACOS_USERNAME=${NACOS_USERNAME:-nacos}
      - NACOS_PASSWORD=${NACOS_PASSWORD:-nacos}
      - NACOS_DISCOVERY_IP=${NACOS_DISCOVERY_IP}
      - MYSQL_HOST=${MYSQL_HOST}
      - MYSQL_PORT=3306
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
      - RABBITMQ_HOST=${RABBITMQ_HOST}
      - RABBITMQ_PORT=5672
      - RABBITMQ_USERNAME=${RABBITMQ_USERNAME:-takeout}
      - RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD}
    depends_on:
      - nacos-check
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped

  delivery-service:
    image: takeout/delivery-service:latest
    container_name: takeout-delivery
    ports:
      - "8087:8087"
    environment:
      - NACOS_SERVER_ADDR=${NACOS_SERVER_ADDR}
      - NACOS_USERNAME=${NACOS_USERNAME:-nacos}
      - NACOS_PASSWORD=${NACOS_PASSWORD:-nacos}
      - NACOS_DISCOVERY_IP=${NACOS_DISCOVERY_IP}
      - MYSQL_HOST=${MYSQL_HOST}
      - MYSQL_PORT=3306
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
      - RABBITMQ_HOST=${RABBITMQ_HOST}
      - RABBITMQ_PORT=5672
      - RABBITMQ_USERNAME=${RABBITMQ_USERNAME:-takeout}
      - RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD}
      - REDIS_HOST=${REDIS_HOST}
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
    depends_on:
      - nacos-check
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped

  search-service:
    image: takeout/search-service:latest
    container_name: takeout-search
    ports:
      - "8088:8088"
    environment:
      - NACOS_SERVER_ADDR=${NACOS_SERVER_ADDR}
      - NACOS_USERNAME=${NACOS_USERNAME:-nacos}
      - NACOS_PASSWORD=${NACOS_PASSWORD:-nacos}
      - NACOS_DISCOVERY_IP=${NACOS_DISCOVERY_IP}
      - MYSQL_HOST=${MYSQL_HOST}
      - MYSQL_PORT=3306
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
    depends_on:
      - nacos-check
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped

  # 辅助服务：等待 Nacos 就绪
  nacos-check:
    image: alpine
    container_name: nacos-check
    command: >
      sh -c "
        echo 'Waiting for Nacos to be ready...';
        until wget -q -O- http://${NACOS_SERVER_ADDR}/nacos/v1/console/health/readiness 2>/dev/null; do
          echo 'Nacos not ready, waiting...';
          sleep 5;
        done;
        echo 'Nacos is ready!';
      "
    restart: "no"
