# ===========================================
# 服务器配置模板
# 复制此文件为 .env 并填入真实值
# .env 文件不会被提交到GitHub
# ===========================================

# 服务器基础IP（所有服务共用）
SERVER_IP=your-server-ip

# Nacos配置
NACOS_PORT=8848

# MySQL配置
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your-mysql-password

# Redis配置
REDIS_PORT=6379

# Nacos凭据
NACOS_USERNAME=nacos
NACOS_PASSWORD=your-nacos-password
